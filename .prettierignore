# Prettier also honours .gitignore. These are tracked files it must never reformat.

# Dated evidence records: kept exactly as captured.
evidence/

# Generated by pnpm.
pnpm-lock.yaml

# Locked v2 design snapshots: rendered screens kept byte-for-byte as reviewed.
docs/design/v2/

# Dated research records: kept exactly as captured, like evidence/.
docs/research/

# HTML test inputs: kept byte-for-byte, often deliberately malformed.
packages/**/fixtures/**/*.html

# The check builder's recorded fixture: the worker's results as recorded, and the BuiltCheck the
# golden test compares byte-for-byte with what serialiseBuilt gives (packages/engine/src/v2/build).
packages/engine/fixtures/v2/build/**/*.json
