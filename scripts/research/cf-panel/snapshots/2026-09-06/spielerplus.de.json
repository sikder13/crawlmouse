ents.forEach(function(backfillElement) {\n            backfillElement.style.display = 'none';\n        });\n    });\n\n    document.addEventListener('ad.consent.declined', function() {\n        var backfillElements = document.querySelectorAll('.adsCPGBackfill');\n        backfillElements.forEach(function(backfillElement) {\n            backfillElement.style.display = 'block';\n        });\n    });\n\n    if (typeof __cmp === 'undefined') {\n        console.log('checkWebViewAdConsent: __cmp not available');\n        document.dispatchEvent(new Event('ad.consent.declined'));\n    }\n    function scrollToSmoothly(pos, time) {\n        var currentPos = window.pageYOffset;\n        var start = null;\n        if(time == null) time = 500;\n        pos = +pos, time = +time;\n        window.requestAnimationFrame(function step(currentTime) {\n            start = !start ? currentTime : start;\n            var progress = currentTime - start;\n            if (currentPos < pos) {\n                window.scrollTo(0, ((pos - currentPos) * progress / time) + currentPos);\n            } else {\n                window.scrollTo(0, currentPos - ((currentPos - pos) * progress / time));\n            }\n            if (progress < time) {\n                window.requestAnimationFrame(step);\n            } else {\n                window.scrollTo(0, pos);\n            }\n        });\n    }</script>\n<script>jQuery(function ($) {\njQuery('#modal').modal({\"show\":false});\nwindow.setTimeout(function() {\n                $('.alert-fade').fadeTo(1000, 0, function(){\n                    $(this).remove(); \n                });\n            }, 5000);\njQuery('#premium-required-modal').modal({\"show\":false});\n});</script></body>\n\n</html>\n",
