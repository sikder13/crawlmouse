{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ]; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . || exit 1; else exit 1; fi",
  "functions": {
    "api/slow.mjs": {
      "includeFiles": "sites/slow/**",
      "maxDuration": 10
    },
    "api/sentinel.mjs": {
      "includeFiles": "sites/sentinel*/**",
      "maxDuration": 10
    },
    "api/large.mjs": {
      "maxDuration": 10
    },
    "api/dense.mjs": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*[Cc]rawlmouse.*"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "/(?:(?:sites|api|blocked\\.html|404\\.html)(?:/.*)?|.*%.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "healthy.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/healthy/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app-shell.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/app-shell/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cf-blocked.lab.crawlmouse.com"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*[Cc]rawlmouse.*"
        }
      ],
      "status": 403,
      "dest": "/blocked.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cf-blocked.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/cf-blocked/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "client-1.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/client-1/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "client-2.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/client-2/$1"
    },
    {
      "src": "/check-ups/",
      "has": [
        {
          "type": "host",
          "value": "client-3.lab.crawlmouse.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://client-3.lab.crawlmouse.com/treatments/check-ups/"
      }
    },
    {
      "src": "/hygiene/",
      "has": [
        {
          "type": "host",
          "value": "client-3.lab.crawlmouse.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://client-3.lab.crawlmouse.com/hygienist/"
      }
    },
    {
      "src": "/hygienist/",
      "has": [
        {
          "type": "host",
          "value": "client-3.lab.crawlmouse.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://client-3.lab.crawlmouse.com/treatments/hygienist-visits/"
      }
    },
    {
      "src": "/offers/",
      "has": [
        {
          "type": "host",
          "value": "client-3.lab.crawlmouse.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://client-3.lab.crawlmouse.com/offers/winter/"
      }
    },
    {
      "src": "/offers/winter/",
      "has": [
        {
          "type": "host",
          "value": "client-3.lab.crawlmouse.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://client-3.lab.crawlmouse.com/offers/winter-2025/"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "client-3.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/client-3/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "client-4.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/client-4/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "client-5.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/client-5/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "client-6.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/client-6/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "trial-client-1.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/trial-client-1/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo-1.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/demo-1/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo-2.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/demo-2/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo-3.lab.crawlmouse.com"
        }
      ],
      "dest": "/sites/demo-3/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "slow.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/slow?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sentinel.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/sentinel?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sentinel-b.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/sentinel?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "large.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/large?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "large-slow.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/large?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "large-throttle.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/large?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "large-throttle-bare.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/large?path=/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dense.lab.crawlmouse.com"
        }
      ],
      "dest": "/api/dense?path=/$1"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
