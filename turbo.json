{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRICE_ID_PRO_MONTHLY",
        "STRIPE_PRICE_ID_PRO_YEARLY",
        "STRIPE_RECONCILE_LIVEMODE",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_ENV",
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "ADMIN_SECRET",
        "NEXT_PUBLIC_BASE_URL",
        "GLOBAL_AUDITS_PER_DAY",
        "ENGINE_V2",
        "AI_READINESS_EXTRACTION",
        "CRAWL_PAUSED",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "test": { "dependsOn": ["^build"] },
    "@crawlmouse/types#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/lib/fixtures/v2/*.json",
        "$TURBO_ROOT$/docs/design/v2/FACTS-proposed.md",
        "$TURBO_ROOT$/docs/design/v2/screens/*.dc.html",
        "$TURBO_ROOT$/docs/specs/v2/11-type-contract.md"
      ]
    },
    "@crawlmouse/engine#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/lib/fixtures/v2/*.json",
        "$TURBO_ROOT$/docs/design/v2/FACTS-proposed.md"
      ]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
