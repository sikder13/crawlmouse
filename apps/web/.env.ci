# CI build environment for `next build` (sourced by .github/workflows/ci.yml, job "build").
# PLACEHOLDERS ONLY. Never put a real key here: this repository is public.
# The values deliberately avoid real key prefixes so the secret scanners never match this file.
# Supabase points at a closed loopback port, so build-time reads fail fast and the routes that
# query at build fall back to their static content.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=ci-placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=ci-placeholder-service-role-key

STRIPE_SECRET_KEY=ci-placeholder-stripe-key
STRIPE_WEBHOOK_SECRET=ci-placeholder-webhook-secret
STRIPE_PRICE_ID_PRO_MONTHLY=ci-placeholder-price-monthly
STRIPE_PRICE_ID_PRO_YEARLY=ci-placeholder-price-yearly
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=ci-placeholder-publishable-key

INNGEST_EVENT_KEY=ci-placeholder-event-key
INNGEST_SIGNING_KEY=ci-placeholder-signing-key

RESEND_API_KEY=ci-placeholder-resend-key

NEXT_PUBLIC_BASE_URL=http://localhost:3000
