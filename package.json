{
  "name": "crawlmouse",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=2",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "smoke": "tsx scripts/smoke-crawl.ts",
    "backtest": "tsx scripts/backtest-engine.ts",
    "golive:check": "pnpm --filter @crawlmouse/scripts golive:check --",
    "qa:seed": "pnpm --filter @crawlmouse/scripts qa:seed --",
    "qa:reset": "pnpm --filter @crawlmouse/scripts qa:reset --",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "research:build-panel": "tsx scripts/research/cf-panel/build-panel.ts",
    "research:snapshot": "tsx scripts/research/cf-panel/snapshot.ts",
    "research:diff": "tsx scripts/research/cf-panel/report.ts",
    "test:templates": "pnpm --filter @crawlmouse/web exec vitest run --config ../../infra/supabase/email-templates/vitest.config.ts",
    "perf:strict": "bash packages/timing/scripts/run-strict.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/instrumentation-http@<0.222.0": "0.222.0"
    }
  }
}
